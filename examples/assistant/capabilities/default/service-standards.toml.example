# Keep real standards in:
# local-only/assistant/capabilities/<capability-id>/service-standards.toml
#
# Standards define which private state signals should not remain unknown for too long,
# and when it is natural for the assistant to ask. The example uses neutral keys.

[[signals]]
key = "example.primary_check"
label = "Primary check"
max_unknown_hours = 24
natural_windows = ["09:00-11:30"]
priority = 50
ask_style = "light_question"

[[signals]]
key = "example.midday_check"
label = "Midday check"
max_unknown_hours = 12
natural_windows = ["12:00-14:30"]
priority = 80
ask_style = "brief_check"

[[signals]]
key = "example.evening_check"
label = "Evening check"
max_unknown_hours = 24
natural_windows = ["18:00-22:30"]
priority = 90
ask_style = "gentle_question"
